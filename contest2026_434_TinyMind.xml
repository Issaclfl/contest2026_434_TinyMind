<?xml version='1.0' encoding='UTF-8'?>
<manifest>
  <!--
    Team repo manifest. Includes the full openvela base project set
    (openvela.xml in this same repo) and adds this team repo as a self-ref
    project, exposing its work-form subdirectories to openvela working-tree
    locations via <linkfile>. remote/default come from the included openvela.xml.
  -->
  <include name="openvela.xml"/>

  <project path="contest2026_434_TinyMind" name="contest2026_434_TinyMind">
    <!-- 应用 / 快应用骨架 -->
    <linkfile src="app/hello_app" dest="packages/demos/contest2026_434_hello_app"/>
    <linkfile src="quickapp/hello_quickapp" dest="packages/apps/contest2026_434_hello_quickapp"/>
    <linkfile src="board/contest_board" dest="vendor/openvela/boards/contest2026_434_board"/>

    <!-- ============================================================
         作品核心：SF32LB52 板载音频驱动
         4 个新增源文件，sync 后自动落到 SiFli 板级目录，无需手工复制。
         另有 4 个既有文件需改动（CMakeLists / defconfig / sifli_ap.c），
         因不能在 manifest 中覆盖仓内既有文件，改由
         board/sf32lb52_audio/apply.sh 一键落盘；diff 见 patches/。
         ============================================================ -->
    <linkfile src="board/sf32lb52_audio/src/bsp_audio.c"
              dest="vendor/sifli/boards/sf32lb52/sf32lb52_devkit_lcd/src/bsp_audio.c"/>
    <linkfile src="board/sf32lb52_audio/src/bsp_audio_hw.c"
              dest="vendor/sifli/boards/sf32lb52/sf32lb52_devkit_lcd/src/bsp_audio_hw.c"/>
    <linkfile src="board/sf32lb52_audio/include/bsp_audio.h"
              dest="vendor/sifli/boards/sf32lb52/sf32lb52_devkit_lcd/include/bsp_audio.h"/>
    <linkfile src="board/sf32lb52_audio/include/bsp_audio_hw.h"
              dest="vendor/sifli/boards/sf32lb52/sf32lb52_devkit_lcd/include/bsp_audio_hw.h"/>
  </project>
</manifest>
