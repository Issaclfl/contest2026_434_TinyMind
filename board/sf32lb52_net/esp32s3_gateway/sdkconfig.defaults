# Build settings the gateway depends on.  net_ppp.c turns several of these into
# compile-time errors, because every one of them fails *silently* at runtime.
#
# No credentials here -- Wi-Fi SSID and password are entered through
# `idf.py menuconfig` and land in sdkconfig, which .gitignore excludes.

CONFIG_IDF_TARGET="esp32s3"

# ---- PPP server ------------------------------------------------------------
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_SERVER_SUPPORT=y
CONFIG_LWIP_PPP_ENABLE_IPV4=y

# The board runs IPv4 only (CONFIG_NET_TUN_PKGSIZE=1500 over a 10.0.0.0/32
# pair).  Leaving IPv6CP enabled only adds negotiation noise to the logs.
CONFIG_LWIP_PPP_ENABLE_IPV6=n

# lwip/Kconfig says it outright: "Please disable this if you're using NAPT on
# PPP interface, since the compressed IP header might not be correctly
# interpreted in NAT causing the compressed packet to be dropped."
CONFIG_LWIP_PPP_VJ_HEADER_COMPRESSION=n

# The board's pppd is built without PAP/CHAP (CONFIG_NETUTILS_PPPD_PAP is not
# set in its defconfig), so the server must not ask for authentication.
CONFIG_LWIP_PPP_PAP_SUPPORT=n
CONFIG_LWIP_PPP_CHAP_SUPPORT=n

# Phase events are the only way to see *where* a failed negotiation stopped.
# They are compiled out unless this is on, with no runtime warning.
CONFIG_LWIP_PPP_NOTIFY_PHASE_SUPPORT=y

# Left off: the board neither sends nor answers LCP echoes, so enabling this
# would only let our side tear down a link that is working fine.
CONFIG_LWIP_ENABLE_LCP_ECHO=n

# ---- NAPT ------------------------------------------------------------------
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y

# The board only ever makes outbound connections, so there is nothing to
# forward inwards.
CONFIG_LWIP_IPV4_NAPT_PORTMAP=n

# ---- flash and partitions --------------------------------------------------
# The module has 16 MB; the default 2 MB would not hold the model partition
# that the local model needs.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- PSRAM: where the local model lives ------------------------------------
# Required by the model, not optional: even stories260K needs 640 KB of KV cache
# on top of its 1 MB of weights, and internal SRAM is only ~300 KB free.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# ---- compute ---------------------------------------------------------------
# llama2.c's matmuls are plain C loops: -O2 is most of the speed.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ---- watchdog --------------------------------------------------------------
# Generation is CPU-bound on purpose and does not yield, so the idle task on
# that core never runs and the default task watchdog would complain every 5 s.
# The run is bounded (it finishes and returns), so watching the idle task is the
# wrong check here; the interrupt watchdog still catches a hung CPU.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# ---- WiFi radio ------------------------------------------------------------
# The driver ROM-prints a console line for every AMPDU receive BA session
# (untagged, not level-gated) from its high-priority task; with a phone
# hotspot this floods the console and starves the PPP UART task -- the board's
# dialling then fails with "peer asked to close".  PPP over UART carries at
# most 460800 baud, so AMPDU receive buys nothing here: turn it off.
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
