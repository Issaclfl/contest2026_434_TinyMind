+/* Line rate for a direct link when the caller does not name one.  Not every
+ * USB-UART bridge can produce the 1000000 that a board's console UART may
+ * have been set up for, but they can all produce 460800.
+ */
+
+#define PPPD_DEFAULT_BAUD 460800
+
 /****************************************************************************
  * Private Data
  ****************************************************************************/
 
+/* Dial-up script for a cellular modem.  A direct serial link to a host has
+ * no modem to talk to, so these apply only when pppd is given no tty.
+ */
+
 static FAR const char connect_script[] =
   "ECHO ON "
   "TIMEOUT 30 "
@@ -62,6 +80,57 @@ static FAR const char disconnect_script[] =
   "\"\" ATZ "
   "OK \\c";
 
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: set_line_rate
+ *
+ * Description:
+ *   Apply a line rate to the serial device before pppd() opens it.  pppd()
+ *   only open()s the tty, so the link runs at whatever rate the driver was
+ *   initialised with, which is not necessarily the rate the peer expects.
+ *
+ ****************************************************************************/
+
+static int set_line_rate(FAR const char *tty, int baud)
+{
+  struct termios term;
+  int fd;
+  int ret;
+
+  fd = open(tty, O_RDWR);
+  if (fd < 0)
+    {
+      return -errno;
+    }
+
+  ret = tcgetattr(fd, &term);
+  if (ret == 0)
+    {
+      cfsetispeed(&term, baud);
+      cfsetospeed(&term, baud);
+      ret = tcsetattr(fd, TCSANOW, &term);
+    }
+
+  close(fd);
+  return ret;
+}
+
+/****************************************************************************
+ * Name: usage
+ ****************************************************************************/
+
+static void usage(FAR const char *progname)
+{
+  printf("Usage: %s [<tty> [<baud>]]\n"
+         "  %s                - dial a cellular modem on /dev/ttyS1\n"
+         "  %s <tty>          - direct serial link at %d baud\n"
+         "  %s <tty> <baud>   - direct serial link at the given rate\n",
+         progname, progname, progname, PPPD_DEFAULT_BAUD, progname);
+}
+
 /****************************************************************************
