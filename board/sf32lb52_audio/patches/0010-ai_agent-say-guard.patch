--- a/packages/ai_agent/src/core/agent_loop.c
+++ b/packages/ai_agent/src/core/agent_loop.c
@@ -884,6 +884,21 @@
 #define WORKING_PHRASE_COUNT \
     ((int)(sizeof(s_working_phrases) / sizeof(s_working_phrases[0])))
 
+bool agent_loop_is_working_phrase(const char* text)
+{
+    if (text == NULL) {
+        return false;
+    }
+
+    for (int i = 0; i < WORKING_PHRASE_COUNT; i++) {
+        if (strcmp(text, s_working_phrases[i]) == 0) {
+            return true;
+        }
+    }
+
+    return false;
+}
