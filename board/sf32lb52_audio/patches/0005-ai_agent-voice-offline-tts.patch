+/* Speak a reply on the board's own speaker without holding up the outbound
+ * queue: TTS round trip plus real-time playback takes seconds. */
+
+static void* say_task(void* arg)
+{
+    char* text = (char*)arg;
+
+    voice_say_text(text);
+    free(text);
+    return NULL;
+}
+
+static void say_async(const char* text)
+{
+    char* copy = strdup(text);
+    pthread_t tid;
+    pthread_attr_t attr;
+
+    if (!copy) {
+        return;
+    }
+
+    pthread_attr_init(&attr);
+    pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+
+    if (pthread_create(&tid, &attr, say_task, copy) != 0) {
+        syslog(LOG_ERR, "[%s] could not start say thread\n", TAG);
+        free(copy);
+    }
+
+    pthread_attr_destroy(&attr);
+}
