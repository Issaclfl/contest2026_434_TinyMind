+/* Speak text through the board's own audio device (TTS + /dev/audio0). */
+
+static void cmd_say(int argc, char** argv)
+{
+    char text[512] = { 0 };
+
+    if (argc < 2) {
+        printf("Usage: say <text>        speak <text> through the speaker\n");
+        printf("       say_auto on|off   speak every reply printed here\n");
+        return;
+    }
+
+    for (int i = 1; i < argc; i++) {
+        strncat(text, argv[i], sizeof(text) - strlen(text) - 1);
+        if (i < argc - 1)
+            strncat(text, " ", sizeof(text) - strlen(text) - 1);
+    }
+
+    printf("Speaking: %s\n", text);
+    int ret = voice_say_text(text);
+    if (ret != 0)
+        printf("say failed: %d\n", ret);
+}
+
+static void cmd_say_auto(int argc, char** argv)
+{
+    if (argc < 2) {
+        printf("Auto-speak is %s\n", voice_say_get_auto() ? "ON" : "OFF");
+        return;
+    }
+
+    int on = (strcmp(argv[1], "on") == 0 || strcmp(argv[1], "1") == 0);
+    voice_say_set_auto(on);
+    printf("Auto-speak %s\n", on ? "ON" : "OFF");
+}
+
+/* Offline audio check: drive the same playback path `say` uses, with a tone * generated on the spot, so the device node can be verified with no network
+ * and no TTS in the loop.  1 kHz square, 0.5 s on / 0.5 s off. */
+
+static void cmd_beep(int argc, char** argv)
+{
+    int seconds = (argc > 1) ? atoi(argv[1]) : 3;
+    const int rate = AGENT_VOICE_SAMPLE_RATE;
+    size_t frames;
+    size_t bytes;
+    short* pcm;
+    audio_playback_t* pb;
+    size_t off = 0;
+    int ret = 0;
+
+    if (seconds < 1 || seconds > 30) {
+        seconds = 3;
+    }
+
+    frames = (size_t)rate * (size_t)seconds;
+    bytes = frames * sizeof(short);
+    pcm = malloc(bytes);
+
+    if (!pcm) {
+        printf("beep: out of memory (%zu bytes)\n", bytes);
+        return;
+    }
+
+    for (size_t i = 0; i < frames; i++) {
+        unsigned int slot = (unsigned int)((i * 2) / (unsigned int)rate);
+        pcm[i] = (slot & 1) ? 0 : 9000;
+    }
+
+    printf("beep: %d s -> %s\n", seconds, voice_say_device());
+
+    pb = audio_playback_open(voice_say_device(), rate, 1, 16);
+    if (!pb) {
+        printf("beep: playback open failed\n");
+        free(pcm);
+        return;
+    }
+
+    while (off < bytes) {
+        ret = audio_playback_write(pb, (const char*)pcm + off, bytes - off);
+        if (ret <= 0) {
+            printf("beep: write failed: %d\n", ret);
+            break;
+        }
+
+        off += (size_t)ret;
+    }
+
+    audio_playback_close(pb);
+    free(pcm);
+    printf("beep: done (%zu bytes)\n", off);
+}
+
+/* Offline announcements: audio shipped in the image, played from /etc/clips.
+ * No network, no TTS engine -- this is what keeps the device talking when the
+ * cloud is gone. */
+
+static void cmd_clip(int argc, char** argv)
+{
+    if (argc < 2) {
+        printf("Usage: clip <name>   (offline announcement from /etc/clips)\n");
+        printf("  light_on  light_off  red_on  blue_on  ok  offline  unknown  temp_high\n");
+        return;
+    }
+
+    int ret = voice_say_clip(argv[1]);
+    if (ret != 0)
+        printf("clip failed: %d\n", ret);
+}
