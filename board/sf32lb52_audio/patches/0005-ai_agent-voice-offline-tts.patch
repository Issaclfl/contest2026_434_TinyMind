+ *     AUDIOIOC_ALLOCBUFFER / AUDIOIOC_ENQUEUEBUFFER.  This is what a board
+ *     whose audio support is an ordinary NuttX lower-half needs -- on such a
+ *     board media_player() is a weak stub (see src/stubs.c) and the upstream
+ *     path cannot produce sound at all.
+ *
+ * The NuttX path mirrors apps/system/nxplayer's playthread, which is the
+ * reference implementation for this device class.
+ */
 
 #include "voice/audio_playback.h"
 #include "agent_config.h"
 
+#include <nuttx/config.h>
+
 #include <errno.h>
