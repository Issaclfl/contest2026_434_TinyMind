+#include <nuttx/audio/audio.h>
+
 static const char* TAG = "audio_pb";
 
 #define PB_OPTIONS_LEN 128
 
+/* Upper bound on buffers we pull from the driver.  The driver decides the
+ * real number through AUDIOIOC_GETBUFFERINFO; this only sizes our arrays. */
+
+#define PB_MAX_BUFFERS 8
+
+/* How long close() waits for AUDIO_MSG_COMPLETE after the final buffer. */
+
+#define PB_COMPLETE_TIMEOUT_MS 5000
+
 static void* s_active_player;
 
 struct audio_playback {
-    void* player;
+    /* common */
     size_t total_written;
     int bytes_per_frame;
     volatile int stopped;
+
+    /* media_player backend */
+    void* player;
+
+    /* NuttX audio device backend */
+    bool pcmdev;
+    int fd;
+    mqd_t mq;
+    char mqname[24];
+    struct ap_buffer_s* buffers[PB_MAX_BUFFERS];
+    struct ap_buffer_s* free_list[PB_MAX_BUFFERS];
+    int nbuffers;
+    int free_n;
+    int buffer_size;
+    unsigned char* acc; /* accumulation buffer, buffer_size bytes */
+    size_t acc_len;
+    int enqueued;
+    bool started;
+    bool complete;
 };
 
+/* ------------------------------------------------------------------ */
+/* NuttX audio device backend                                          */
+/* ------------------------------------------------------------------ */
+
+static void pcmdev_reclaim(struct audio_playback* pb, struct audio_msg_s* msg)
+{
+    if (msg->msg_id == AUDIO_MSG_DEQUEUE) {
+        if (msg->u.ptr && pb->free_n < pb->nbuffers) {
+            pb->free_list[pb->free_n++] = msg->u.ptr;
+        }
+    } else if (msg->msg_id == AUDIO_MSG_COMPLETE) {
+        pb->complete = true;
+    }
+}
+
+/* Wait for one dequeued buffer.  Returns OK, or -EPIPE once the driver has
+ * reported COMPLETE (nothing else is coming). */
+
+static int pcmdev_wait_buffer(struct audio_playback* pb)
+{
+    struct audio_msg_s msg;
+    unsigned int prio;
+
+    while (pb->free_n == 0) {
+        ssize_t n = mq_receive(pb->mq, (char*)&msg, sizeof(msg), &prio);
+        if (n != sizeof(msg)) {
+            if (errno == EINTR) {
+                continue;
+            }
+
+            syslog(LOG_ERR, "[%s] mq_receive failed: %d\n", TAG, errno);
+            return -EIO;
+        }
+
+        pcmdev_reclaim(pb, &msg);
+        if (pb->complete && pb->free_n == 0) {
+            return -EPIPE;
+        }
+    }
+
+    return OK;
+}
+
+/* Copy whatever sits in the accumulation buffer into a driver buffer and
+ * enqueue it.  With final set the buffer carries AUDIO_APB_FINAL, which is
+ * what makes the lower half deliver AUDIO_CALLBACK_COMPLETE (and, on boards
+ * that need it, drain the last DMA half). */
+
+static int pcmdev_enqueue(struct audio_playback* pb, bool final)
+{
+    struct audio_buf_desc_s bufdesc;
+    struct ap_buffer_s* apb;
+    int ret;
+
+    if (pb->acc_len == 0 && !final) {
+        return OK;
+    }
+
+    ret = pcmdev_wait_buffer(pb);
+    if (ret < 0) {
+        return ret;
+    }
+
+    apb = pb->free_list[--pb->free_n];
+    apb->curbyte = 0;
+    apb->nbytes = pb->acc_len;
+    apb->flags = final ? AUDIO_APB_FINAL : 0;
+
+    if (pb->acc_len > 0) {
+        memcpy(apb->samp, pb->acc, pb->acc_len);
+    }
+
+    pb->acc_len = 0;
+
+    bufdesc.numbytes = apb->nbytes;
+    bufdesc.u.buffer = apb;
+
+    ret = ioctl(pb->fd, AUDIOIOC_ENQUEUEBUFFER, (unsigned long)&bufdesc);
+    if (ret < 0) {
+        syslog(LOG_ERR, "[%s] enqueue failed: %d\n", TAG, errno);
+        pb->free_list[pb->free_n++] = apb;
+        return -EIO;
+    }
+
+    pb->total_written += apb->nbytes;
+    pb->enqueued++;
+
+    /* Start once the lower half's staging can be filled outright (two
+     * buffers, or whatever the driver asked for), or on the final buffer for
+     * clips shorter than that.  Starting earlier makes the driver serve a
+     * half with nothing queued and count an underrun -- audible as a clipped
+     * first syllable. */
+
+    if (!pb->started && (pb->enqueued >= 2 || final)) {
+        ret = ioctl(pb->fd, AUDIOIOC_START, 0);
+        if (ret < 0) {
+            syslog(LOG_ERR, "[%s] start failed: %d\n", TAG, errno);
+            return -EIO;
+        }
+
+        pb->started = true;
+    }
+
+    return OK;
+}
+
+static int pcmdev_write(struct audio_playback* pb, const void* buf, size_t len)
+{
+    const unsigned char* src = buf;
+    size_t left = len;
+
+    while (left > 0) {
+        size_t room = (size_t)pb->buffer_size - pb->acc_len;
+        size_t take = left < room ? left : room;
+
+        memcpy(pb->acc + pb->acc_len, src, take);
+        pb->acc_len += take;
+        src += take;
+        left -= take;
+
+        if (pb->acc_len == (size_t)pb->buffer_size) {
+            int ret = pcmdev_enqueue(pb, false);
+            if (ret < 0) {
+                return ret;
+            }
+        }
+    }
+
+    return (int)len;
+}
+
+static void pcmdev_close(struct audio_playback* pb)
+{
+    struct audio_buf_desc_s bufdesc;
+    struct timespec ts;
+    struct audio_msg_s msg;
+    unsigned int prio;
+    int i;
+    int left_ms = PB_COMPLETE_TIMEOUT_MS;
+
+    if (pb->fd < 0) {
+        return;
+    }
+
+    /* Push the tail (even if empty) so the driver sees AUDIO_APB_FINAL and
+     * can close the stream out. */
+
+    if (pb->started && !pb->complete) {
+        int ret = pcmdev_enqueue(pb, true);
+        if (ret < 0) {
+            syslog(LOG_WARNING, "[%s] final enqueue: %d\n", TAG, ret);
+        }
+    }
+
+    /* Recover buffers until COMPLETE or timeout.  A timeout is not fatal:
+     * the point is to give the driver a chance to finish, not to hang. */
+
+    while (pb->started && !pb->complete && left_ms > 0) {
+        clock_gettime(CLOCK_REALTIME, &ts);
+        ts.tv_sec += 1;
+
+        ssize_t n = mq_timedreceive(pb->mq, (char*)&msg, sizeof(msg), &prio,
+            &ts);
+        if (n != sizeof(msg)) {
+            if (errno == ETIMEDOUT) {
+                left_ms -= 1000;
+                continue;
+            }
+
+            if (errno == EINTR) {
+                continue;
+            }
+
+            break;
+        }
+
+        pcmdev_reclaim(pb, &msg);
+    }
+
+    if (pb->started) {
+        ioctl(pb->fd, AUDIOIOC_STOP, 0);
+    }
+
+    syslog(LOG_INFO, "[%s] closing (%zu bytes written, complete=%d)\n", TAG,
+        pb->total_written, pb->complete ? 1 : 0);
+
+    ioctl(pb->fd, AUDIOIOC_UNREGISTERMQ, (unsigned long)pb->mq);
+    ioctl(pb->fd, AUDIOIOC_RELEASE, 0);
+
+    for (i = 0; i < pb->nbuffers; i++) {
+        if (pb->buffers[i]) {
+            bufdesc.numbytes = pb->buffer_size;
+            bufdesc.u.buffer = pb->buffers[i];
+            ioctl(pb->fd, AUDIOIOC_FREEBUFFER, (unsigned long)&bufdesc);
+            pb->buffers[i] = NULL;
+        }
+    }
+
+    close(pb->fd);
+    pb->fd = -1;
+
+    if (pb->mq != (mqd_t)-1) {
+        mq_close(pb->mq);
+        mq_unlink(pb->mqname);
+        pb->mq = (mqd_t)-1;
+    }
+
+    if (pb->acc) {
+        free(pb->acc);
+        pb->acc = NULL;
+    }
+}
+
+static audio_playback_t* pcmdev_open(const char* dev_path,
+    unsigned int sample_rate, unsigned int channels,
+    unsigned int bits_per_sample)
+{
+    struct audio_caps_desc_s cap_desc;
+    struct ap_buffer_info_s buf_info;
+    struct audio_buf_desc_s bufdesc;
+    struct mq_attr attr;
+    audio_playback_t* pb;
+    int i;
+    int ret;
+
+    pb = calloc(1, sizeof(*pb));
+    if (!pb) {
+        return NULL;
+    }
+
+    pb->pcmdev = true;
+    pb->fd = -1;
+    pb->mq = (mqd_t)-1;
+    pb->bytes_per_frame = (bits_per_sample / 8) * channels;
+
+    pb->fd = open(dev_path, O_RDWR | O_CLOEXEC);
+    if (pb->fd < 0) {
+        syslog(LOG_ERR, "[%s] open(%s) failed: %d\n", TAG, dev_path, errno);
+        free(pb);
+        return NULL;
+    }
+
+    memset(&cap_desc, 0, sizeof(cap_desc));
+    cap_desc.caps.ac_len = sizeof(struct audio_caps_s);
+    cap_desc.caps.ac_type = AUDIO_TYPE_OUTPUT;
+    cap_desc.caps.ac_channels = channels;
+    cap_desc.caps.ac_chmap = 0;
+    cap_desc.caps.ac_controls.hw[0] = sample_rate;
+    cap_desc.caps.ac_controls.b[3] = sample_rate >> 16;
+    cap_desc.caps.ac_controls.b[2] = bits_per_sample;
+    cap_desc.caps.ac_subtype = AUDIO_FMT_PCM;
+
+    ret = ioctl(pb->fd, AUDIOIOC_CONFIGURE, (unsigned long)&cap_desc);
+    if (ret < 0) {
+        syslog(LOG_ERR, "[%s] configure(%uHz %uch %ubit) failed: %d\n", TAG,
+            sample_rate, channels, bits_per_sample, errno);
+        goto err;
+    }
+
+    memset(&buf_info, 0, sizeof(buf_info));
+    if (ioctl(pb->fd, AUDIOIOC_GETBUFFERINFO, (unsigned long)&buf_info) < 0) {
+        buf_info.buffer_size = CONFIG_AUDIO_BUFFER_NUMBYTES;
+        buf_info.nbuffers = CONFIG_AUDIO_NUM_BUFFERS;
+    }
+
+    if (buf_info.nbuffers > PB_MAX_BUFFERS) {
+        buf_info.nbuffers = PB_MAX_BUFFERS;
+    }
+
+    pb->nbuffers = buf_info.nbuffers;
+    pb->buffer_size = buf_info.buffer_size;
+
+    for (i = 0; i < pb->nbuffers; i++) {
+        bufdesc.numbytes = pb->buffer_size;
+        bufdesc.u.pbuffer = &pb->buffers[i];
+        if (ioctl(pb->fd, AUDIOIOC_ALLOCBUFFER, (unsigned long)&bufdesc)
+            != sizeof(bufdesc)) {
+            syslog(LOG_ERR, "[%s] alloc buffer %d failed\n", TAG, i);
+            goto err;
+        }
+
+        /* Everything starts out free. */
+
+        pb->free_list[pb->free_n++] = pb->buffers[i];
+    }
+
+    pb->acc = malloc(pb->buffer_size);
+    if (!pb->acc) {
+        goto err;
+    }
+
+    pb->acc_len = 0;
+
+    attr.mq_maxmsg = pb->nbuffers + 8;
+    attr.mq_msgsize = sizeof(struct audio_msg_s);
+    attr.mq_curmsgs = 0;
+    attr.mq_flags = 0;
+
+    snprintf(pb->mqname, sizeof(pb->mqname), "/tmp/apb%0lx",
+        (unsigned long)((uintptr_t)pb));
+
+    pb->mq = mq_open(pb->mqname, O_RDWR | O_CREAT, 0644, &attr);
+    if (pb->mq == (mqd_t)-1) {
+        syslog(LOG_ERR, "[%s] mq_open failed: %d\n", TAG, errno);
+        goto err;
+    }
+
+    ioctl(pb->fd, AUDIOIOC_REGISTERMQ, (unsigned long)pb->mq);
+
+    /* The device is started by the first enqueue, not here: see
+     * pcmdev_enqueue(). */
+
+    syslog(LOG_INFO, "[%s] opened %s (%uHz %uch %ubit, %d x %d B)\n", TAG,
+        dev_path, sample_rate, channels, bits_per_sample, pb->nbuffers,
+        pb->buffer_size);
+    return pb;
+
+err:
+    pcmdev_close(pb);
+    free(pb);
+    return NULL;
+}
