+/* mimo_tts.c - TTS backend for the Xiaomi MiMo OpenAI-compatible endpoint.
+ *
+ * The MiMo platform does not expose /v1/audio/speech.  Its TTS models are
+ * reached through the ordinary chat route:
+ *
+ *   POST /v1/chat/completions
+ *   {"model":"mimo-v2.5-tts",
+ *    "messages":[{"role":"assistant","content":"<text to speak>"}],
+ *    "audio":{"format":"wav","voice":"<voice>"}}
+ *
+ * The audio comes back as base64 inside choices[0].message.audio.data, i.e.
+ * as text, which the board's TLS client (vela_https_request) can carry
+ * without any binary-response support.  The payload is a 24 kHz mono 16-bit
+ * WAV; this backend decodes it and resamples to the 16 kHz mono 16-bit PCM
+ * that the voice channel contract (include/voice/voice_tts.h) specifies --
+ * 16 kHz is also one of the two rates this board's audio clock table has.
+ *
+ * Credentials: reuses the LLM API key from the config store (set_llm), which
+ * is the same token-plan credential the chat endpoint accepts.
+ */
+
+#include "voice/voice_tts.h"
+#include "agent_compat.h"
+#include "agent_config.h"
+#include "infra/config_store.h"
+#include "infra/vela_tls.h"
+
+#include <errno.h>
+#include <mbedtls/base64.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <syslog.h>
+
+static const char* TAG = "mimo_tts";
+
+#define MIMO_TTS_HOST "token-plan-cn.xiaomimimo.com"
+#define MIMO_TTS_PORT "443"
+#define MIMO_TTS_PATH "/v1/chat/completions"
+#define MIMO_TTS_MODEL "mimo-v2.5-tts"
+#define MIMO_TTS_DEFAULT_VOICE "冰糖"
+
+/* Response budget.  The JSON holds base64 of a 24 kHz WAV, so 768 KB of
+ * response covers roughly 12 s of speech; callers that need more split the
+ * text and call again (see voice_say_text in nsh_commands.c). */
+
+#define MIMO_TTS_RESP_CAP (768 * 1024)
+
+/* The contract output is 16 kHz; the WAV comes at 24 kHz. */
+
+#define MIMO_TTS_OUT_RATE 16000
+
+static char s_api_key[192];
+static char s_voice[64];
+
+/* ------------------------------------------------------------------ */
+
+static int mimo_tts_init(void)
+{
+    memset(s_api_key, 0, sizeof(s_api_key));
+    memset(s_voice, 0, sizeof(s_voice));
+
+    claw_config_get(AGENT_CFG_KEY_API_KEY, s_api_key, sizeof(s_api_key));
+
+    if (claw_config_get(AGENT_CFG_KEY_TTS_VOICE, s_voice, sizeof(s_voice))
+            != OK
+        || s_voice[0] == '\0') {
+        strncpy(s_voice, MIMO_TTS_DEFAULT_VOICE, sizeof(s_voice) - 1);
+    }
+
+    syslog(LOG_INFO, "[%s] init: key=%s voice=%s\n", TAG,
+        s_api_key[0] ? "set" : "MISSING", s_voice);
+    return 0;
+}
+
+/* Whether the backend has what it needs to synthesize. */
+
+int mimo_tts_ready(void)
+{
+    if (!s_api_key[0]) {
+        mimo_tts_init();
+    }
+
+    return s_api_key[0] != '\0';
+}
+
+/* ------------------------------------------------------------------ */
+/* Request building                                                    */
+/* ------------------------------------------------------------------ */
+
+static char* json_escape(const char* src)
+{
+    size_t n = 0;
+    char* out;
+
+    for (const char* p = src; *p; p++) {
+        n += (*p == '"' || *p == '\\') ? 2 : 1;
+    }
+
+    out = malloc(n + 1);
+    if (!out) {
+        return NULL;
+    }
+
+    char* q = out;
+    for (const char* p = src; *p; p++) {
+        if (*p == '"' || *p == '\\') {
+            *q++ = '\\';
+        }
+
+        *q++ = *p;
+    }
+
+    *q = '\0';
+    return out;
+}
+
+static char* build_body(const char* text, const char* voice)
+{
+    char* esc = json_escape(text);
+    char* body;
+    size_t cap;
+
+    if (!esc) {
+        return NULL;
+    }
+
+    cap = strlen(esc) + strlen(voice) + 256;
+    body = malloc(cap);
+    if (body) {
+        snprintf(body, cap,
+            "{\"model\":\"%s\",\"messages\":[{\"role\":\"assistant\","
+            "\"content\":\"%s\"}],\"audio\":{\"format\":\"wav\","
+            "\"voice\":\"%s\"}}",
+            MIMO_TTS_MODEL, esc, voice);
+    }
+
+    free(esc);
+    return body;
+}
+
+/* ------------------------------------------------------------------ */
+/* Response parsing                                                    */
+/* ------------------------------------------------------------------ */
+
+/* Locate the base64 payload in choices[0].message.audio.data without
+ * building a full cJSON tree: the string can be several hundred KB and we
+ * only need one field out of it. */
+
+static const char* find_audio_b64(const char* resp, size_t* b64_len)
+{
+    const char* audio = strstr(resp, "\"audio\"");
+    const char* data;
+    const char* end;
+
+    if (!audio) {
+        return NULL;
+    }
+
+    data = strstr(audio, "\"data\":\"");
+    if (!data) {
+        return NULL;
+    }
+
+    data += strlen("\"data\":\"");
+
+    /* base64 never contains a quote, so the next quote terminates it. */
+
+    end = strchr(data, '"');
+    if (!end || end == data) {
+        return NULL;
+    }
+
+    *b64_len = (size_t)(end - data);
+    return data;
+}
+
+struct wav_info {
+    unsigned int rate;
+    unsigned int channels;
+    unsigned int bits;
+    const unsigned char* pcm;
+    size_t pcm_len;
+};
+
+static bool parse_wav(const unsigned char* buf, size_t len, struct wav_info* out)
+{
+    size_t pos = 12; /* skip "RIFF" + size + "WAVE" */
+
+    memset(out, 0, sizeof(*out));
+
+    if (len < 44 || memcmp(buf, "RIFF", 4) != 0 || memcmp(buf + 8, "WAVE", 4)) {
+        return false;
+    }
+
+    while (pos + 8 <= len) {
+        const unsigned char* id = buf + pos;
+        unsigned int size = (unsigned int)buf[pos + 4]
+            | ((unsigned int)buf[pos + 5] << 8)
+            | ((unsigned int)buf[pos + 6] << 16)
+            | ((unsigned int)buf[pos + 7] << 24);
+        const unsigned char* body = buf + pos + 8;
+
+        if (memcmp(id, "fmt ", 4) == 0 && size >= 16 && pos + 8 + 16 <= len) {
+            out->channels = (unsigned int)body[2] | ((unsigned int)body[3] << 8);
+            out->rate = (unsigned int)body[4] | ((unsigned int)body[5] << 8)
+                | ((unsigned int)body[6] << 16)
+                | ((unsigned int)body[7] << 24);
+            out->bits = (unsigned int)body[14] | ((unsigned int)body[15] << 8);
+        } else if (memcmp(id, "data", 4) == 0) {
+            size_t avail = len - (pos + 8);
+            out->pcm = body;
+            out->pcm_len = size < avail ? size : avail;
+            break;
+        }
+
+        pos += 8 + size + (size & 1); /* chunks are word aligned */
+    }
+
+    return out->pcm != NULL && out->rate > 0 && out->channels > 0;
+}
+
+/* 24 kHz -> 16 kHz, mono, 16-bit.  Ratio 3:2, taking one sample as-is and
+ * averaging the next pair -- a cheap low-pass that keeps speech clean enough
+ * while the board's audio clock table stays on its 16 kHz row. */
+
+static size_t resample_3to2(const short* in, size_t in_frames, short* out,
+    size_t out_cap)
+{
+    size_t out_frames = (in_frames * 2) / 3;
+    size_t k;
+
+    if (out_frames > out_cap) {
+        out_frames = out_cap;
+    }
+
+    for (k = 0; k < out_frames; k++) {
+        size_t pair = k / 2;
+        size_t idx = pair * 3;
+
+        if ((k & 1) == 0) {
+            out[k] = in[idx];
+        } else {
+            int a = in[idx + 1];
+            int b = (idx + 2 < in_frames) ? in[idx + 2] : a;
+            out[k] = (short)((a + b) / 2);
+        }
+    }
+
+    return out_frames;
+}
+
+/* ------------------------------------------------------------------ */
+/* Synthesize                                                          */
+/* ------------------------------------------------------------------ */
+
+static int mimo_tts_synthesize(const char* text, unsigned char* pcm_out,
+    size_t pcm_cap, size_t* pcm_len)
+{
+    char* body = NULL;
+    char* resp = NULL;
+    unsigned char* wav = NULL;
+    const char* b64;
+    size_t b64_len = 0;
+    size_t wav_len = 0;
+    size_t wav_cap;
+    struct wav_info info;
+    size_t frames;
+    size_t out_frames;
+    int status;
+    int ret = -EIO;
+
+    if (!text || !text[0] || !pcm_out || !pcm_len) {
+        return -EINVAL;
+    }
+
+    *pcm_len = 0;
+
+    if (!s_api_key[0]) {
+        mimo_tts_init();
+    }
+
+    if (!s_api_key[0]) {
+        syslog(LOG_ERR, "[%s] no API key (run: set_llm <url> <key> <model>)\n",
+            TAG);
+        return -EACCES;
+    }
+
+    body = build_body(text, s_voice);
+    resp = malloc(MIMO_TTS_RESP_CAP);
+
+    if (!body || !resp) {
+        ret = -ENOMEM;
+        goto out;
+    }
+
+    vela_header_t auth[2];
+    memset(auth, 0, sizeof(auth));
+    auth[0].name = "Authorization";
+    static char auth_value[256];
+    snprintf(auth_value, sizeof(auth_value), "Bearer %s", s_api_key);
+    auth[0].value = auth_value;
+
+    status = vela_https_request(MIMO_TTS_HOST, MIMO_TTS_PORT, "POST",
+        MIMO_TTS_PATH, auth, body, strlen(body), resp, MIMO_TTS_RESP_CAP, NULL);
+
+    if (status != 200) {
+        syslog(LOG_ERR, "[%s] HTTP %d: %.120s\n", TAG, status, resp);
+        ret = -EIO;
+        goto out;
+    }
+
+    b64 = find_audio_b64(resp, &b64_len);
+    if (!b64) {
+        syslog(LOG_ERR, "[%s] no audio.data in response (%.80s)\n", TAG, resp);
+        ret = -EIO;
+        goto out;
+    }
+
+    /* Decoded size is at most 3/4 of the base64 length. */
+
+    wav_cap = (b64_len / 4) * 3 + 4;
+    wav = malloc(wav_cap);
+    if (!wav) {
+        ret = -ENOMEM;
+        goto out;
+    }
+
+    if (mbedtls_base64_decode(wav, wav_cap, &wav_len,
+            (const unsigned char*)b64, b64_len)
+        != 0) {
+        syslog(LOG_ERR, "[%s] base64 decode failed (%zu chars)\n", TAG,
+            b64_len);
+        ret = -EIO;
+        goto out;
+    }
+
+    if (!parse_wav(wav, wav_len, &info)) {
+        syslog(LOG_ERR, "[%s] not a WAV payload (%zu bytes)\n", TAG, wav_len);
+        ret = -EIO;
+        goto out;
+    }
+
+    frames = info.pcm_len / (info.bits / 8) / info.channels;
+
+    syslog(LOG_INFO, "[%s] got %zu bytes WAV, %u Hz %uch %ubit, %zu frames\n",
+        TAG, wav_len, info.rate, info.channels, info.bits, frames);
+
+    if (info.rate == MIMO_TTS_OUT_RATE && info.channels == 1 && info.bits == 16) {
+        size_t bytes = info.pcm_len < pcm_cap ? info.pcm_len : pcm_cap;
+        memcpy(pcm_out, info.pcm, bytes);
+        *pcm_len = bytes & ~(size_t)1;
+        ret = 0;
+        goto out;
+    }
+
+    if (info.rate != 24000 || info.channels != 1 || info.bits != 16) {
+        syslog(LOG_ERR, "[%s] unsupported WAV layout\n", TAG);
+        ret = -ENOSYS;
+        goto out;
+    }
+
+    out_frames = resample_3to2((const short*)info.pcm, frames,
+        (short*)pcm_out, pcm_cap / 2);
+    *pcm_len = out_frames * 2;
+
+    syslog(LOG_INFO, "[%s] resampled 24000 -> %d Hz: %zu frames, %zu bytes\n",
+        TAG, MIMO_TTS_OUT_RATE, out_frames, *pcm_len);
+    ret = 0;
+
+out:
+    free(body);
+    free(resp);
+    free(wav);
+    return ret;
+}
+
+/* ------------------------------------------------------------------ */
+/* Backend registration                                                */
+/* ------------------------------------------------------------------ */
+
+static const voice_tts_ops_t s_mimo_tts_ops = {
+    .name = "mimo",
+    .init = mimo_tts_init,
+    .synthesize = mimo_tts_synthesize,
+    .deinit = NULL,
+};
+
+int mimo_tts_register(void)
+{
+    return voice_tts_register(&s_mimo_tts_ops);
+}
