+/* audio_playback.c - Streaming audio playback.
+ *
+ * Two backends behind the one interface in audio_playback.h:
+ *
+ *   - media_player (Vela media framework, buffer mode): used when dev_path
+ *     is NULL or does not name a device node.  Unchanged upstream behaviour.
+ *
+ *   - A plain NuttX audio device (dev_path begins with "/dev/"): opens the
