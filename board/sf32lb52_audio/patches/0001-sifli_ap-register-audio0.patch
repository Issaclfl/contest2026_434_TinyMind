     }
 #endif
 
+#ifdef CONFIG_AUDIO
+  /* SF32LB52 on-chip audio codec: onboard analog mic in, speaker out
+   * through the Class-D PA (enable on PA10).  Register as /dev/audio0. */
+
+  FAR struct audio_lowerhalf_s *audio = sf32lb52_audio_initialize();
+  if (audio == NULL)
+    {
+      syslog(LOG_ERR, "ERROR: sf32lb52_audio_initialize failed\n");
+    }
+  else
+    {
+      ret = audio_register("/dev/audio0", audio);
+      if (ret < 0)
+        {
+          syslog(LOG_ERR, "ERROR: audio_register(/dev/audio0) failed: %d\n",
+                 ret);
+          kmm_free(audio);
+        }
+      else
+        {
+          syslog(LOG_INFO, "audio: /dev/audio0 registered\n");
+        }
+    }
+#endif
