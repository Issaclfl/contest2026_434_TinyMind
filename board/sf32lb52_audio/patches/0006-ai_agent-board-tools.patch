+/* Board actuators and sensors.
+ *
+ * These are the tools that let the agent act on the device it runs on rather
+ * than only talk about it: the LCD backlight is a real PWM output, and the
+ * keys are real GPIO inputs.  Board-specific by nature -- the device paths
+ * below are the ones the SF32LB52-DevKit-LCD registers. */
+
+#pragma once
+
+#include <stddef.h>
+
+int tool_set_backlight_execute(const char *input_json, char *output,
+                               size_t output_size);
+int tool_read_buttons_execute(const char *input_json, char *output,
+                              size_t output_size);
diff --git a/src/tools/tool_registry.c b/src/tools/tool_registry.c
index 33583e7..97b4822 100644
--- a/src/tools/tool_registry.c
+++ b/src/tools/tool_registry.c
@@ -27,6 +27,7 @@
 #endif
 #include "tools/tool_guard.h"
 #include "tools/tool_control.h"
+#include "tools/tool_board.h"
 #include "tools/tool_cron.h"
 #include "tools/tool_feishu_chat.h"
 #include "tools/tool_feishu_doc.h"
@@ -368,6 +369,27 @@ int tool_registry_init(void)
             TOOL_SCHEMA_END(),
         tool_vibrate_execute);
 
+    /* Board tools.  Every other tool either talks to the network or pokes at
+     * files; these two are wired to hardware the agent is sitting on -- a PWM
+     * output driving the LCD backlight and a GPIO input reading the keys. */
+
+    REGISTER_TOOL(
+        "set_backlight",
+        "Set the LCD backlight brightness as a percentage: 0 turns it off, "
+        "100 is brightest. Use this when the user asks to dim, brighten or "
+        "turn off the screen.",
+        TOOL_SCHEMA_BEGIN()
+            TOOL_PARAM_NUM("level", "Brightness 0-100")
+            TOOL_SCHEMA_END_REQUIRED("\"level\""),
+        tool_set_backlight_execute);
+
+    REGISTER_TOOL_NO_PARAMS(
+        "read_buttons",
+        "Read the board's physical keys. Reports whether the key is being "
+        "held down right now. Use this when the user asks about the buttons "
+        "or wants to know if one is pressed.",
+        tool_read_buttons_execute);
+
     /* Feishu document tools */
     REGISTER_TOOL(
         "feishu_doc_create",
@@ -526,6 +548,15 @@ void tool_registry_cleanup(void)
     free(s_tools_json);
     s_tools_json = NULL;
     s_tool_count = 0;
+
+    /* Mark the cache dirty again.  Without this, a second run of the agent in
+     * the same boot re-registers every tool but build_tools_json_locked()
+     * early-returns (the dirty flag was cleared by the first build), leaving
+     * s_tools_json NULL -- so the model is sent a request with no tools at
+     * all.  The first run after a boot works; every later one silently loses
+     * the whole toolset. */
+
+    s_tools_dirty = true;
     pthread_mutex_unlock(&s_tools_mtx);
 }
 
