+/* Live readings.  All of them are cheap: getifaddrs() is a few ioctls, the
+ * router getter copies a struct under a mutex, and the clock is the clock. */
+
+/* First non-loopback IPv4 address and its interface name.  This is the link
+ * row: with the PPP session up the board has 10.0.0.2 and the gateway is
+ * whatever the point-to-point destination says. */
+
+static bool link_reading(char* ip, size_t ip_len, char* ifname, size_t ifname_len,
+    char* peer, size_t peer_len)
+{
+    struct ifaddrs* list = NULL;
+    bool found = false;
+
+    ip[0] = '\0';
+    peer[0] = '\0';
+    ifname[0] = '\0';
+
+    if (getifaddrs(&list) != 0) {
+        return false;
+    }
+
+    for (struct ifaddrs* ifa = list; ifa != NULL; ifa = ifa->ifa_next) {
+        if (ifa->ifa_addr == NULL || ifa->ifa_addr->sa_family != AF_INET) {
+            continue;
+        }
+
+        if (ifa->ifa_name != NULL && strncmp(ifa->ifa_name, "lo", 2) == 0) {
+            continue;
+        }
+
+        struct sockaddr_in* sin = (struct sockaddr_in*)ifa->ifa_addr;
+        uint32_t addr = ntohl(sin->sin_addr.s_addr);
+
+        if (addr == 0 || (addr >> 24) == 127) {
+            continue; /* interface exists but has no address yet */
+        }
+
+        inet_ntop(AF_INET, &sin->sin_addr, ip, ip_len);
+
+        if (ifa->ifa_name != NULL) {
+            snprintf(ifname, ifname_len, "%s", ifa->ifa_name);
+        }
+
+        if (peer != NULL && ifa->ifa_dstaddr != NULL
+            && ifa->ifa_dstaddr->sa_family == AF_INET) {
+            struct sockaddr_in* dst = (struct sockaddr_in*)ifa->ifa_dstaddr;
+            uint32_t p = ntohl(dst->sin_addr.s_addr);
+            if (p != 0 && (p >> 24) != 127) {
+                inet_ntop(AF_INET, &dst->sin_addr, peer, peer_len);
+            }
+        }
+
+        found = true;
+        break;
+    }
+
+    freeifaddrs(list);
+    return found;
+}
+
+/* "0:12:34" -- uptime, not wall clock: this board has no RTC and a wrong
+ * date on screen is worse than none. */
+
+static void uptime_text(char* out, size_t out_len)
+{
+    struct timespec ts;
+    unsigned long secs;
+
+    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) {
+        snprintf(out, out_len, "--:--:--");
+        return;
+    }
+
+    secs = (unsigned long)ts.tv_sec;
+    snprintf(out, out_len, "%lu:%02lu:%02lu", secs / 3600, (secs / 60) % 60,
+        secs % 60);
+}
+
+static void row_set(int idx, const char* text)
+{
+    if (idx < 0 || idx >= SCREEN_ROWS || s_rows[idx] == NULL) {
+        return;
+    }
