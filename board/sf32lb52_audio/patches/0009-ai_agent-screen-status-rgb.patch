+/* Re-read everything that is not pushed by a caller.  Runs in the LVGL thread
+ * (LVGL is single-threaded), once a second. */
+
+static void status_tick(lv_timer_t* timer)
+{
+    char ip[20];
+    char ifname[12];
+    char peer[20];
+    char line[SCREEN_ROW_MAX];
+    char up[20];
+
+    (void)timer;
+
+    uptime_text(up, sizeof(up));
+    lv_label_set_text(s_uptime, up);
+
+    bool linked = link_reading(ip, sizeof(ip), ifname, sizeof(ifname), peer,
+        sizeof(peer));
+
+    /* Log only on change: this line is how the bring-up is verified over the
+     * serial console, and a line a second would drown the console. */
+
+    static bool was_linked = false;
+    static bool first = true;
+
+    if (first || linked != was_linked) {
+        first = false;
+        was_linked = linked;
+        if (linked) {
+            syslog(LOG_INFO, "[%s] link up: %s %s%s%s\n", TAG, ifname, ip,
+                peer[0] ? " -> " : "", peer);
+        } else {
+            syslog(LOG_WARNING, "[%s] link down: no address yet\n", TAG);
+        }
+    }
+
+    if (linked) {
+        snprintf(line, sizeof(line), "已连接 %s", ip);
+        row_set(ROW_LINK, line);
+        lv_obj_set_style_bg_color(s_dot, lv_color_hex(COL_OK), 0);
+    } else {
+        row_set(ROW_LINK, "未连接，等 PPP 拨号");
+        lv_obj_set_style_bg_color(s_dot, lv_color_hex(COL_BAD), 0);
+    }
+
+    /* Where the board's requests go, and how many it has made.  Both come
+     * from the router, so this row is "what the board is actually using",
+     * not what it was configured with at build time. */
+
+    llm_backend_t be;
+    static char last_model[SCREEN_ROW_MAX];
+    static unsigned last_calls = 0xffffffffu;
+
+    if (llm_router_get_backend(0, &be) == 0) {
+        /* 精度是显式的：host/model 都是 64/128 字节的数组，直接 "%s" 会被
+         * -Werror=format-truncation 拦下来（板子上的行宽也放不下那么长）。 */
+        if (be.host[0] != '\0' && be.model[0] != '\0') {
+            snprintf(line, sizeof(line), "%.24s @ %.40s", be.model, be.host);
+        } else {
+            snprintf(line, sizeof(line), "%.40s", be.model[0] ? be.model : "未配置");
+        }
+
+        if (strcmp(line, last_model) != 0) {
+            snprintf(last_model, sizeof(last_model), "%s", line);
+            row_set(ROW_MODEL, line);
+            syslog(LOG_INFO, "[%s] routed model: %s\n", TAG, line);
+        }
+
+        if (be.total_calls != last_calls) {
+            last_calls = be.total_calls;
+            snprintf(line, sizeof(line), "%u 次", (unsigned)be.total_calls);
+            row_set(ROW_CALLS, line);
+        }
+    } else {
+        row_set(ROW_MODEL, "未配置");
+    }
+}
+
+/* Bring-up + the LVGL loop, all in one thread. */
+
+static void* screen_task(void* arg)
+{
+    const char* fb = s_fb_path;
+    const char* input = s_input_path;
+    lv_nuttx_dsc_t info;
+    lv_nuttx_result_t result;
+    int waited = 0;
+
+    (void)arg;
+
+    while (waited < SCREEN_WAIT_MS) {
+        if ((!fb || access(fb, F_OK) == 0) && (!input || access(input, F_OK) == 0)) {
+            break;
+        }
+
+        usleep(500 * 1000);
+        waited += 500;
+    }
+
+    if (fb && access(fb, F_OK) != 0) {
+        syslog(LOG_WARNING, "[%s] %s never appeared (waited %d ms): no screen\n",
+            TAG, fb, waited);
+        return NULL;
+    }
+
+    lv_init();
+    lv_nuttx_dsc_init(&info);
+
+    if (fb) {
+        info.fb_path = fb;
+    }
+
+    if (input) {
+        info.input_path = input;
+    }
+
+    lv_nuttx_init(&info, &result);
+    if (result.disp == NULL) {
+        syslog(LOG_WARNING, "[%s] no display on %s\n", TAG, fb ? fb : "(default)");
+        return NULL;
+    }
+
+    font_setup();
+
+    lv_obj_t* scr = lv_obj_create(NULL);
+    int width = lv_display_get_horizontal_resolution(result.disp);
+    int height = lv_display_get_vertical_resolution(result.disp);
+    syslog(LOG_INFO, "[%s] panel %dx%d\n", TAG, width, height);
+    ui_build(scr, width, height);
+
+    lv_timer_create(status_tick, SCREEN_TICK_MS, NULL);
+    status_tick(NULL); /* fill the rows before the first second is up */
+
+    backlight_set(100);
+    syslog(LOG_INFO, "[%s] backlight on (%s)\n", TAG, SCREEN_BL_DEV);
+
+    s_running = true;
+    syslog(LOG_INFO, "[%s] up: %s\n", TAG, fb ? fb : "(default)");
+
+    uint32_t last_bl = 0;
+    uint32_t elapsed = 0;
+
+    while (s_running) {
+        char body[SCREEN_TEXT_MAX];
+        char prompt[SCREEN_ROW_MAX];
+        char clip[SCREEN_ROW_MAX];
+        char count[SCREEN_ROW_MAX];
+        bool have_body = false;
+        bool have_prompt = false;
+        bool have_clip = false;
+
+        pthread_mutex_lock(&s_lock);
+        if (s_body_waiting) {
+            memcpy(body, s_body_text, sizeof(body));
+            s_body_waiting = false;
+            have_body = true;
+        }
+        if (s_prompt_waiting) {
+            snprintf(prompt, sizeof(prompt), "%s", s_prompt);
+            s_prompt_waiting = false;
+            have_prompt = true;
+        }
+        if (s_clip_waiting) {
+            snprintf(clip, sizeof(clip), "%s", s_clip);
+            s_clip_waiting = false;
+            have_clip = true;
+        }
+        snprintf(count, sizeof(count), "%u 次", s_cmds);
+        pthread_mutex_unlock(&s_lock);
+        if (have_body && s_body) {
+            lv_label_set_text(s_body, body);
+            syslog(LOG_INFO, "[%s] show: %.60s\n", TAG, body);
+        }
+
+        if (have_prompt) {
+            row_set(ROW_PROMPT, prompt);
+            row_set(ROW_CALLS, count);
+        }
+
+        if (have_clip) {
+            row_set(ROW_CLIP, clip[0] ? clip : "还没有播报");
+        }
+
+        uint32_t idle = lv_timer_handler();
+        usleep((idle > 0 && idle < 100 ? idle : 10) * 1000);
+
+        /* Re-assert the backlight every few seconds. */
+
+        elapsed += idle > 0 ? idle : 10;
+        if (elapsed - last_bl >= SCREEN_BL_REASSERT_MS) {
+            last_bl = elapsed;
+            backlight_set(100);
+        }
+    }
+
+    return NULL;
+}
+
+int agent_screen_init(const char* fb_path, const char* input_path)
+{
+    pthread_attr_t attr;
+
+    if (s_inited) {
+        return OK;
+    }
+
+    s_inited = true;
+
+    if (fb_path) {
+        strncpy(s_fb_path, fb_path, sizeof(s_fb_path) - 1);
+    }
+
+    if (input_path) {
+        strncpy(s_input_path, input_path, sizeof(s_input_path) - 1);
+    }
+
+    strncpy(s_font_path, AGENT_SCREEN_FONT_PATH, sizeof(s_font_path) - 1);
+
+    pthread_attr_init(&attr);
+    pthread_attr_setstacksize(&attr, SCREEN_TASK_STACK);
+
+    if (pthread_create(&s_task, &attr, screen_task, NULL) != 0) {
+        syslog(LOG_ERR, "[%s] bring-up thread create failed\n", TAG);
+        pthread_attr_destroy(&attr);
+        return -EIO;
+    }
+
+    pthread_attr_destroy(&attr);
+    return OK;
+}
+
+void agent_screen_show(const char* text)
+{
+    if (!s_running || !text || !text[0]) {
+        return;
+    }
+
+    pthread_mutex_lock(&s_lock);
+    strncpy(s_body_text, text, sizeof(s_body_text) - 1);
+    s_body_text[sizeof(s_body_text) - 1] = '\0';
+    s_body_waiting = true;
+    pthread_mutex_unlock(&s_lock);
+}
+
+/* The command the user just gave.  This is the row that makes the panel
+ * self-explanatory on video: the viewer sees "打开RGB" go in and
+ * "RGB灯已打开" come out. */
+
+void agent_screen_set_prompt(const char* text)
+{
+    if (!s_running || !text || !text[0]) {
+        return;
+    }
+
+    pthread_mutex_lock(&s_lock);
+    strncpy(s_prompt, text, sizeof(s_prompt) - 1);
+    s_prompt[sizeof(s_prompt) - 1] = '\0';
+    s_prompt_waiting = true;
+    s_cmds++;
+    pthread_mutex_unlock(&s_lock);
+}
+
+/* The offline announcement that just played, by its clip name.  Shows the
+ * audio half of the demo as machine state rather than as a claim. */
+
+void agent_screen_set_clip(const char* name)
+{
+    if (!s_running) {
+        return;
+    }
+
+    pthread_mutex_lock(&s_lock);
+    if (name && name[0]) {
+        snprintf(s_clip, sizeof(s_clip), "离线片段 %s", name);
+    } else {
+        s_clip[0] = '\0';
+    }
+    s_clip_waiting = true;
+    pthread_mutex_unlock(&s_lock);
+}
+
+#else /* !CONFIG_GRAPHICS_LVGL */
+
+/* Built without LVGL: nothing to draw on, and the callers stay unchanged. */
+
+static const char* TAG = "screen";
+
+int agent_screen_init(const char* fb_path, const char* input_path)
+{
+    (void)fb_path;
+    (void)input_path;
+    syslog(LOG_INFO, "[%s] LVGL not enabled: no status screen\n", TAG);
+    return -ENODEV;
+}
+
+void agent_screen_show(const char* text)
+{
+    (void)text;
+}
+
+void agent_screen_set_prompt(const char* text)
+{
+    (void)text;
+}
+
+void agent_screen_set_clip(const char* name)
+{
+    (void)name;
+}
+
+#endif /* CONFIG_GRAPHICS_LVGL */
