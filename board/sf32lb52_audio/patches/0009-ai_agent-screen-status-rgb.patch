+/* Pick the best font available on this build, degrading loudly if needed. */
+
+static void font_setup(void)
+{
+#if LV_USE_FREETYPE
+    if (s_font_path[0] && access(s_font_path, F_OK) == 0) {
+        /* "already initialised" is not a failure: another component of the
+         * system may have brought FreeType up first, and we can still create
+         * our own font on top of it. */
+
+        lv_result_t init_res = lv_freetype_init(LV_FREETYPE_CACHE_FT_GLYPH_CNT);
+        if (init_res != LV_RESULT_OK) {
+            syslog(LOG_INFO, "[%s] lv_freetype_init: %d (continuing)\n", TAG,
+                init_res);
+        }
+
+        s_font = lv_freetype_font_create(s_font_path,
+            LV_FREETYPE_FONT_RENDER_MODE_BITMAP, SCREEN_BODY_PX,
+            LV_FREETYPE_FONT_STYLE_NORMAL);
+        s_font_md = lv_freetype_font_create(s_font_path,
+            LV_FREETYPE_FONT_RENDER_MODE_BITMAP, SCREEN_MID_PX,
+            LV_FREETYPE_FONT_STYLE_NORMAL);
+        s_font_sm = lv_freetype_font_create(s_font_path,
+            LV_FREETYPE_FONT_RENDER_MODE_BITMAP, SCREEN_SMALL_PX,
+            LV_FREETYPE_FONT_STYLE_NORMAL);
+
+        if (s_font && s_font_md && s_font_sm) {
+            syslog(LOG_INFO, "[%s] FreeType font: %s (%d/%d/%d px)\n", TAG,
+                s_font_path, SCREEN_BODY_PX, SCREEN_MID_PX, SCREEN_SMALL_PX);
+        } else {
+            syslog(LOG_WARNING, "[%s] FreeType could not open %s\n", TAG,
+                s_font_path);
+        }
+    } else {
+        syslog(LOG_WARNING, "[%s] no font at %s\n", TAG, s_font_path);
+    }
+#endif
+
+#if LV_FONT_SIMSUN_16_CJK
+    if (!s_font || !s_font_sm) {
+        /* Thin glyph set: some Chinese will still come out as boxes. */
+        s_font = (lv_font_t*)&lv_font_simsun_16_cjk;
+        s_font_md = s_font;
+        s_font_sm = s_font;
+        syslog(LOG_WARNING, "[%s] falling back to built-in simsun subset\n", TAG);
+    }
+#endif
+
+    if (!s_font || !s_font_md || !s_font_sm) {
+        s_font = (lv_font_t*)&lv_font_montserrat_14;
+        s_font_md = s_font;
+        s_font_sm = s_font;
+        syslog(LOG_WARNING, "[%s] falling back to montserrat: no CJK\n", TAG);
+    }
+
+    /* Anything the CJK font lacks (rare) still gets a chance.  In this LVGL
+     * version the fallback is a struct field, not a setter. */
+
+    s_font->fallback = &lv_font_montserrat_14;
+}
