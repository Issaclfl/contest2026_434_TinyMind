+
+/* Minimal agent status screen.
+ *
+ * The upstream LVGL chat channel (lvgl_ui_channel.c) assumes a 466x466 round
+ * watch panel, a Vela/FreeType CJK font service and a system that already
+ * owns LVGL.  A bare devkit board has none of those, so this brings up LVGL
+ * the way apps/examples/lvgldemo does and draws the board's own status page.
+ *
+ * Everything on it is a reading, not decoration: the link row comes from
+ * getifaddrs(), the model and call count from the LLM router, the last
+ * command and the last announcement from the callers below.
+ *
+ * init returns OK, or a negative errno when there is no display to drive
+ * (in which case the setters are no-ops). */
+
+int agent_screen_init(const char* fb_path, const char* input_path);
+
+/* Replace the announcement text -- the big line in the middle of the panel.
+ * Safe to call from any thread; the label is updated by the LVGL task. */
+
+void agent_screen_show(const char* text);
+
+/* Note the command the user just gave (the "最近指令" row), and count it. */
+
+void agent_screen_set_prompt(const char* text);
+
+/* Note the offline announcement that just played, by its clip name. */
+
+void agent_screen_set_clip(const char* name);
+
+#ifdef __cplusplus
+}
