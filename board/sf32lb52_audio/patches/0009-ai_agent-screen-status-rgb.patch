+#define SCREEN_BL_DEV "/dev/pwm0" /* GPTIM1_CH4 on PA01 -> LCD backlight */
+#define SCREEN_BL_FREQ 1000
+#define SCREEN_BL_REASSERT_MS 5000
+
+/* Keep the panel lit.  The backlight is a plain PWM, and anything that pokes
+ * /dev/pwm0 (a tool call, another app) can leave the screen dark; re-asserting
+ * the duty periodically makes the status screen survive that. */
+
+static void backlight_set(int level)
+{
+    struct pwm_info_s info;
+    int fd = open(SCREEN_BL_DEV, O_RDWR);
+
+    if (fd < 0) {
+        return;
+    }
+
+    memset(&info, 0, sizeof(info));
+    info.frequency = SCREEN_BL_FREQ;
+    info.duty = (ub16_t)(((uint32_t)level * 65535u) / 100u);
+
+    ioctl(fd, PWMIOC_SETCHARACTERISTICS, (unsigned long)(uintptr_t)&info);
+    ioctl(fd, PWMIOC_START, 0);
+    close(fd); /* the output keeps running: close only drops a reference */
+}
