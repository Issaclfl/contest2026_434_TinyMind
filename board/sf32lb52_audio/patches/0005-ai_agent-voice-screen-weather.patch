+static int pcmdev_wait_buffer(struct audio_playback* pb)
+{
+    struct audio_msg_s msg;
+    unsigned int prio;
+
+    while (pb->free_n == 0) {
+        ssize_t n = mq_receive(pb->mq, (char*)&msg, sizeof(msg), &prio);
