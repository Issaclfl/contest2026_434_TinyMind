+        size_t room = (size_t)pb->buffer_size - pb->acc_len;
+        size_t take = left < room ? left : room;
+
+        memcpy(pb->acc + pb->acc_len, src, take);
+        pb->acc_len += take;
+        src += take;
+        left -= take;
+
+        if (pb->acc_len == (size_t)pb->buffer_size) {
+            int ret = pcmdev_enqueue(pb, false);
+            if (ret < 0) {
