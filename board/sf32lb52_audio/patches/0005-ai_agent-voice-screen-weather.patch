+
+/* The no-LLM fast path hands us whatever text preceded "天气", so it can be
+ * "今天", "北京今天" or "请问北京".  Time and filler words are not place
+ * names: strip them wherever they appear and let the remainder be the city
+ * (an empty remainder means "resolve it from the egress IP", i.e. report the
+ * local weather). */
+
+static void weather_clean_location(char *loc)
+{
+    static const char *noise[] = {
+        "今天", "明天", "后天", "现在", "当前", "当地", "本地", "我这儿",
+        "这里", "天气", "怎么样", "如何", "请问", "查一下", "看看", "查",
+        "一下", "的", "吗", "呢",
+    };
+
+    for (size_t i = 0; i < sizeof(noise) / sizeof(noise[0]); i++) {
+        size_t nlen = strlen(noise[i]);
+
+        for (;;) {
+            char *hit = strstr(loc, noise[i]);
+            if (!hit) {
+                break;
+            }
+
+            memmove(hit, hit + nlen, strlen(hit + nlen) + 1);
+        }
+    }
+
+    /* Trim spaces from both ends. */
+
+    char *s = loc;
+    while (*s == ' ' || *s == '\t') {
+        s++;
+    }
+
+    if (s != loc) {
+        memmove(loc, s, strlen(s) + 1);
+    }
+
+    size_t n = strlen(loc);
+    while (n > 0 && (loc[n - 1] == ' ' || loc[n - 1] == '\t')) {
+        loc[--n] = '\0';
+    }
+}
+
+static int weather_location_is_noise(const char *loc)
+{
+    static const char *noise[] = {
+        "今天", "明天", "后天", "现在", "当前", "当地", "本地", "我这儿",
+        "这里", "这", "的", "查", "查一下", "看看", "怎么样", "如何",
+        "today", "tomorrow", "now", "local", "here", "currently", "the",
+    };
+
+    for (size_t i = 0; i < sizeof(noise) / sizeof(noise[0]); i++) {
+        if (strcasecmp(noise[i], loc) == 0) {
+            return 1;
+        }
+    }
+
+    return 0;
+}
