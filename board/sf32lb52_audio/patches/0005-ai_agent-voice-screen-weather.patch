diff --git a/src/voice/voice_say.c b/src/voice/voice_say.c
new file mode 100644
index 0000000..45eaed1
--- /dev/null
+++ b/src/voice/voice_say.c
@@ -0,0 +1,382 @@
+/*
+ * Copyright (C) 2026 Xiaomi Corporation
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+/* voice_say.c - Turn a string into sound on the board's own audio device.
+ *
+ * This is the piece that makes the device talk: the active TTS backend
+ * (mimo_tts.c on this board) produces 16 kHz mono 16-bit PCM, and
+ * audio_playback_write() streams it to the device node -- no media_player,
+ * no MP3, no files.
+ *
+ * Long replies are spoken in chunks: each chunk is one TTS round trip, so
+ * memory stays flat and playback starts before the whole answer is ready.
+ */
+
+#include "voice/voice_say.h"
+
+#include "agent_compat.h"
+#include "agent_config.h"
+#include "infra/config_store.h"
+#include "voice/audio_playback.h"
+#include "voice/mimo_tts.h"
+#include "voice/voice_tts.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <syslog.h>
+#include <unistd.h>
+
+static const char* TAG = "say";
+
+/* PCM scratch: one chunk of speech at a time. */
+
+#define SAY_PCM_CAP (512 * 1024)
+
+/* Chunking.  Chinese text is 3 bytes per character in UTF-8, so the soft
+ * limit below is roughly 40 characters -- about 9 s of speech, comfortably
+ * inside mimo_tts.c's response budget. */
+
+#define SAY_SOFT_MAX 128
+#define SAY_MIN_STOP 24
+#define SAY_CHUNK_MAX 256
+
+static const char* s_stops = "。！？；!?;\n";
+
+static pthread_mutex_t s_lock = PTHREAD_MUTEX_INITIALIZER;
+static volatile int s_auto;
+static int s_registered;
+static char s_dev[64];
+
+/* ------------------------------------------------------------------ */
+
+int voice_say_init(void)
+{
+    if (s_registered) {
+        return OK;
+    }
+
+    if (mimo_tts_register() != OK) {
+        syslog(LOG_ERR, "[%s] TTS backend registration failed\n", TAG);
+        return -EIO;
+    }
+
+    /* Registering makes it active when it is the first backend.  If the user
+     * configured Volcengine credentials, leave those in charge instead. */
+
+    char volc_key[8] = { 0 };
+
+    if (claw_config_get(AGENT_CFG_KEY_VOLC_API_KEY, volc_key, sizeof(volc_key))
+            == OK
+        && volc_key[0]) {
+        syslog(LOG_INFO, "[%s] keeping volcengine backend (key present)\n", TAG);
+    } else if (voice_tts_set_backend("mimo") != OK) {
+        syslog(LOG_WARNING, "[%s] could not select mimo backend\n", TAG);
+    }
+
+    s_registered = 1;
+    syslog(LOG_INFO, "[%s] TTS backend: %s\n", TAG, voice_tts_get_backend());
+
+    return OK;
+}
+
+void voice_say_set_auto(int on)
+{
+    s_auto = on ? 1 : 0;
+}
+
+int voice_say_get_auto(void)
+{
+    return s_auto;
+}
+
+/* Where to play.  The config store wins, then the board's own node if it is
+ * there, then the compile-time default (other boards). */
+
+static const char* playback_dev(void)
+{
+    if (s_dev[0]) {
+        return s_dev;
+    }
+
+    if (claw_config_get(AGENT_CFG_KEY_AUDIO_PLAYBACK_DEV, s_dev, sizeof(s_dev))
+            == OK
+        && s_dev[0]) {
+        return s_dev;
+    }
+
+    if (access("/dev/audio0", F_OK) == 0) {
+        strncpy(s_dev, "/dev/audio0", sizeof(s_dev) - 1);
+    } else {
+        strncpy(s_dev, AGENT_AUDIO_PLAYBACK_DEV, sizeof(s_dev) - 1);
+    }
+
+    syslog(LOG_INFO, "[%s] playback device: %s\n", TAG, s_dev);
+    return s_dev;
+}
+
+/* The device `say` plays on; also used by the offline `beep` check. */
+
+const char* voice_say_device(void)
+{
+    return playback_dev();
+}
+
+/* Offline announcements: audio rendered once and shipped in the image (the
+ * board's /etc is a romfs), so the device can speak with no network and no
+ * TTS engine in the loop.  Anything not in the clip set still needs the
+ * cloud path -- see the note in docs/. */
+
+#define SAY_CLIP_DIR "/etc/clips/"
+
+int voice_say_clip(const char* name)
+{
+    char path[96];
+    unsigned char buf[4096];
+    audio_playback_t* pb;
+    size_t total = 0;
+    ssize_t n;
+    int fd;
+    int ret = OK;
+
+    if (!name || !name[0]) {
+        return -EINVAL;
+    }
+
+    snprintf(path, sizeof(path), SAY_CLIP_DIR "%s.pcm", name);
+
+    fd = open(path, O_RDONLY);
+    if (fd < 0) {
+        syslog(LOG_ERR, "[%s] clip '%s' not found (%s)\n", TAG, name, path);
+        return -ENOENT;
+    }
+
+    pthread_mutex_lock(&s_lock);
+
+    pb = audio_playback_open(playback_dev(), AGENT_VOICE_SAMPLE_RATE,
+        AGENT_VOICE_CHANNELS, AGENT_VOICE_BITS);
+
+    if (!pb) {
+        pthread_mutex_unlock(&s_lock);
+        close(fd);
+        return -EIO;
+    }
+
+    while ((n = read(fd, buf, sizeof(buf))) > 0) {
+        size_t off = 0;
+
+        while (off < (size_t)n) {
+            int w = audio_playback_write(pb, buf + off, (size_t)n - off);
+            if (w <= 0) {
+                ret = w;
+                goto out;
+            }
+
+            off += (size_t)w;
+        }
+
+        total += (size_t)n;
+    }
+
+out:
+    audio_playback_close(pb);
+    pthread_mutex_unlock(&s_lock);
+    close(fd);
+
+    syslog(LOG_INFO, "[%s] clip %s: %zu bytes (%.1f s)%s\n", TAG, name, total,
+        (double)total / (AGENT_VOICE_SAMPLE_RATE * 2),
+        (ret == OK) ? "" : " (aborted)");
+    return ret;
+}
+
+/* Drop the markdown punctuation a chat model likes to sprinkle in; reading
+ * asterisks and backticks aloud is pure noise. */
+
+static void strip_markup(char* s)
+{
+    char* w = s;
+
+    for (char* r = s; *r; r++) {
+        if (*r == '*' || *r == '`' || *r == '#') {
+            continue;
+        }
+
+        *w++ = *r;
+    }
+
+    *w = '\0';
+}
+
+static int synth_and_play(const char* chunk, unsigned char* pcm, size_t cap)
+{
+    size_t pcm_len = 0;
+    int ret;
+
+    ret = voice_tts_speak(chunk, pcm, cap, &pcm_len);
+    if (ret != OK) {
+        syslog(LOG_ERR, "[%s] TTS failed: %d\n", TAG, ret);
+        return ret;
+    }
+
+    if (pcm_len == 0) {
+        return OK;
+    }
+
+    audio_playback_t* pb = audio_playback_open(playback_dev(), AGENT_VOICE_SAMPLE_RATE,
+        AGENT_VOICE_CHANNELS, AGENT_VOICE_BITS);
+
+    if (!pb) {
+        syslog(LOG_ERR, "[%s] playback open failed (%s)\n", TAG, playback_dev());
+        return -EIO;
+    }
+
+    size_t off = 0;
+
+    while (off < pcm_len) {
+        int n = audio_playback_write(pb, pcm + off, pcm_len - off);
+        if (n <= 0) {
+            syslog(LOG_ERR, "[%s] write failed: %d\n", TAG, n);
+            ret = n;
+            break;
+        }
+
+        off += (size_t)n;
+    }
+
+    audio_playback_close(pb);
+
+    syslog(LOG_INFO, "[%s] played %zu bytes (%.1f s)\n", TAG, off,
+        (double)off / (AGENT_VOICE_SAMPLE_RATE * 2));
+
+    return ret;
+}
+
+static size_t utf8_char_len(unsigned char c)
+{
+    if (c < 0x80) {
+        return 1;
+    }
+
+    if ((c & 0xE0) == 0xC0) {
+        return 2;
+    }
+
+    if ((c & 0xF0) == 0xE0) {
+        return 3;
+    }
+
+    if ((c & 0xF8) == 0xF0) {
+        return 4;
+    }
+
+    return 1;
+}
+
+int voice_say_text(const char* text)
+{
+    unsigned char* pcm;
+    char* clean;
+    char chunk[SAY_CHUNK_MAX];
+    size_t clen = 0;
+    size_t len;
+    size_t i = 0;
+    int played = 0;
+    int ret = -EINVAL;
+
+    if (!text || !text[0]) {
+        return -EINVAL;
+    }
+
+    if (voice_say_init() != OK) {
+        return -EIO;
+    }
+
+    if (!mimo_tts_ready()) {
+        syslog(LOG_ERR, "[%s] no TTS credentials; run: set_llm <url> <key> <model>\n",
+            TAG);
+        return -EACCES;
+    }
+
+    len = strlen(text);
+    clean = malloc(len + 1);
+    pcm = malloc(SAY_PCM_CAP);
+
+    if (!clean || !pcm) {
+        free(clean);
+        free(pcm);
+        return -ENOMEM;
+    }
+
+    memcpy(clean, text, len + 1);
+    strip_markup(clean);
+    len = strlen(clean);
+
+    pthread_mutex_lock(&s_lock);
+
+    syslog(LOG_INFO, "[%s] speaking %zu bytes: \"%.60s\"\n", TAG, len, clean);
+
+    while (i < len) {
+        size_t n = utf8_char_len((unsigned char)clean[i]);
+
+        if (i + n > len) {
+            n = 1;
+        }
+
+        if (clen + n + 1 > sizeof(chunk)) {
+            chunk[clen] = '\0';
+            if (synth_and_play(chunk, pcm, SAY_PCM_CAP) == OK) {
+                played = 1;
+            }
+
+            clen = 0;
+        }
+
+        memcpy(chunk + clen, clean + i, n);
+        clen += n;
+        i += n;
+
+        bool is_stop = (n == 1) && strchr(s_stops, chunk[clen - 1]) != NULL;
+
+        if ((is_stop && clen >= SAY_MIN_STOP) || clen >= SAY_SOFT_MAX) {
+            chunk[clen] = '\0';
+            if (synth_and_play(chunk, pcm, SAY_PCM_CAP) == OK) {
+                played = 1;
+            }
+
+            clen = 0;
+        }
+    }
+
+    if (clen > 0) {
+        chunk[clen] = '\0';
+        if (synth_and_play(chunk, pcm, SAY_PCM_CAP) == OK) {
+            played = 1;
+        }
+    }
+
+    pthread_mutex_unlock(&s_lock);
+
+    free(clean);
+    free(pcm);
+
+    ret = played ? OK : -EIO;
+    syslog(LOG_INFO, "[%s] done: %d\n", TAG, ret);
+    return ret;
+}
