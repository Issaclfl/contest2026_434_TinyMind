+static void pcmdev_reclaim(struct audio_playback* pb, struct audio_msg_s* msg)
+{
+    if (msg->msg_id == AUDIO_MSG_DEQUEUE) {
+        if (msg->u.ptr && pb->free_n < pb->nbuffers) {
+            pb->free_list[pb->free_n++] = msg->u.ptr;
+        }
