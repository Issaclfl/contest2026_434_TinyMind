+/* The audio device `say` plays on (config override, else the board's node). */
+
+const char* voice_say_device(void);
+
+/* Play a pre-rendered announcement from /etc/clips/<name>.pcm.
+ * No network, no TTS engine: this is the offline voice path. */
+
+int voice_say_clip(const char* name);
