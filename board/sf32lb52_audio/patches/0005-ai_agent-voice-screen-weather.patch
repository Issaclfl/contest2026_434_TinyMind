+    pb->acc_len = 0;
+
+    bufdesc.numbytes = apb->nbytes;
+    bufdesc.u.buffer = apb;
+
+    ret = ioctl(pb->fd, AUDIOIOC_ENQUEUEBUFFER, (unsigned long)&bufdesc);
+    if (ret < 0) {
+        syslog(LOG_ERR, "[%s] enqueue failed: %d\n", TAG, errno);
+        pb->free_list[pb->free_n++] = apb;
+        return -EIO;
+    }
+
+    pb->total_written += apb->nbytes;
+    pb->enqueued++;
