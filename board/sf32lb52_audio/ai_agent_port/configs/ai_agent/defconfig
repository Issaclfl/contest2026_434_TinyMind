# ---- network stack (board has no NIC; PPP over UART comes later) ----
CONFIG_NET=y
CONFIG_NET_TCP=y
CONFIG_NET_UDP=y
CONFIG_NET_BROADCAST=y
CONFIG_NET_ICMP_SOCKET=y
